// use prisma-8

model User {
    id        Int      @id @default(autoincrement())
    email     String   @unique
    password  String
    createdAt DateTime @default(now())

    foods     Food[]
}

model Food {
    id          Int      @id @default(autoincrement())
    name        String
    description String?
    price       Int
    category    String
    createdAt   DateTime @default(now())

    userId      Int
    user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}